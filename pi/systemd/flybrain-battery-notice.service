[Unit]
Description=flybrain standing experiment battery: notice (data/experiments/STANDING_BATTERY_PREREG.md)

[Service]
Type=oneshot
TimeoutStartSec=6h
WorkingDirectory=%h/flybrain/data/experiments
ExecStart=/usr/bin/python3 %h/flybrain/data/experiments/battery.py notice
StandardOutput=append:%h/flybrain/data/experiments/battery.log
StandardError=append:%h/flybrain/data/experiments/battery.log
