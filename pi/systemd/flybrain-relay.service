[Unit]
Description=flybrain stream relay (OBS source on :8765, always up; forwards the game on :8766)
After=network-online.target

[Service]
WorkingDirectory=%h/flybrain
ExecStart=/usr/bin/python3 -m flybrain.relay 8765 http://127.0.0.1:8766
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
